# Скопируйте в .env и задайте свои значения. Файл .env в Git не добавляется.
DB_USER=labqueue
DB_PASSWORD=change-me
BASE_URL=http://localhost:8080
# true за HTTPS-прокси (Caddy); false — для проверки на localhost по HTTP
COOKIE_SECURE=false
# Администратор создаётся при первом запуске
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=change-me-123
